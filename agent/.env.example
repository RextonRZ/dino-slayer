# ======================================================================
#  TEMPLATE ONLY - THIS FILE IS COMMITTED TO GIT.
#  NEVER put a real key here. Real keys go in agent/.env, which is
#  gitignored.
#
#      copy agent\.env.example agent\.env
#      then edit agent\.env
# ======================================================================

# Gemini. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here

# Which Gemini model to use.
GEMINI_MODEL=gemini-2.5-flash

# Tracing. https://smith.langchain.com -> Settings -> API Keys
# The key is the switch. Put one here and every run is traced: which tools the
# agent picked, what each returned, and every time the guardrail sent an answer
# back to be rewritten. Leave it blank and tracing stays off.
# LANGSMITH_PROJECT is just a label you choose; LangSmith creates it on the
# first trace, so any name works.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tanya-dino
