dataset/web/_fixture_*

# Full-size mascot art. Only the resized web/ set is loaded by the page, and
# these originals are 11 MB the clone does not need. Kept locally as the source
# to re-export from.
dashboard/public/mascot/*.png

# OS
Thumbs.db
.DS_Store

# Full-size logo art, 6250x6250 source files. The page loads only the resized
# logo-nav-*.png and favicon.png; nothing in the repo references these. Kept
# locally as the source to re-export from, same as the mascot originals above.
dashboard/public/dino-slayer-logo-*.png
